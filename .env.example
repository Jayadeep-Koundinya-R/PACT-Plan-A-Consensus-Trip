# ==============================================================================
# PACT — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to .env or configure in your EAS Build Secrets / Vercel Env Vars.
# Note: Variables prefixed with EXPO_PUBLIC_ are bundled into client code.

# 1. Supabase Backend (Database, Auth, Realtime & Storage)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. RevenueCat In-App Purchases (iOS & Android SDK Configuration)
EXPO_PUBLIC_RC_IOS_KEY=appl_your_revenuecat_ios_public_key
EXPO_PUBLIC_RC_ANDROID_KEY=goog_your_revenuecat_android_public_key

# 3. Serverless Edge Functions & Webhooks (Supabase / Server-only)
REVENUECAT_WEBHOOK_AUTH=your_secret_bearer_token_for_webhook
GEMINI_API_KEY=your_google_gemini_api_key_for_server_edge_function
