{
  "cleanUrls": true,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index"
    },
    {
      "source": "/circle/:id/:tab",
      "destination": "/circle/[id]/:tab"
    },
    {
      "source": "/join/:code",
      "destination": "/join/[code]"
    },
    {
      "source": "/invite/:code",
      "destination": "/invite/[code]"
    }
  ]
}